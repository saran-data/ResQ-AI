*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/

# Node.js / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel
