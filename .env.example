# =============================================================
# ResQAI - Environment Configuration
# Copy this file to .env and fill in your actual values
# =============================================================

# ----- APPLICATION -----
APP_NAME=ResQAI
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- DATABASE (PostgreSQL) -----
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=resqai_db
DATABASE_USER=resqai_user
DATABASE_PASSWORD=resqai_secure_password_change_me
DATABASE_URL=postgresql+asyncpg://resqai_user:resqai_secure_password_change_me@postgres:5432/resqai_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# ----- REDIS -----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_change_me
REDIS_DB=0
REDIS_URL=redis://:redis_secure_password_change_me@redis:6379/0
REDIS_CACHE_TTL=3600

# ----- QDRANT (Vector Database) -----
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=qdrant_api_key_change_me
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NGO=ngo_profiles
QDRANT_COLLECTION_RESTAURANT=restaurant_profiles
QDRANT_COLLECTION_FOOD_SAFETY=food_safety_guidelines
QDRANT_COLLECTION_DONATIONS=donation_history
QDRANT_COLLECTION_KNOWLEDGE=knowledge_base

# ----- JWT AUTH -----
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- OAUTH2 -----
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ----- AI MODELS -----
# OpenAI (GPT-4o) - Reasoning, NGO Matching, Analytics
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# Anthropic (Claude 3.5) - Long docs, Food Safety, Admin Bot
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=8192

# Google AI (Gemini 1.5) - Image understanding, Food Analysis
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-1.5-pro
GEMINI_VISION_MODEL=gemini-1.5-pro-vision

# Ollama (Llama 3) - Offline reasoning, Volunteer Agent
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_LLAMA=llama3:8b
OLLAMA_MODEL_MISTRAL=mistral:7b

# DeepSeek - Route optimization, Fraud Detection
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Mistral - Lightweight operations, Notifications
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# ----- GOOGLE MAPS / PLACES -----
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api

# ----- WEATHER API -----
OPENWEATHER_API_KEY=your-openweather-api-key
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ----- CLOUDINARY (Image Storage) -----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=resqai

# ----- EMAIL (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@resqai.org
SMTP_FROM_NAME=ResQAI Platform
SMTP_USE_TLS=true

# ----- TWILIO (SMS + WhatsApp) -----
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ----- FIREBASE (Push Notifications) -----
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# ----- KAFKA (Event Streaming) -----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=resqai-consumers
KAFKA_TOPIC_DONATIONS=resqai.donations
KAFKA_TOPIC_NOTIFICATIONS=resqai.notifications
KAFKA_TOPIC_AI_DECISIONS=resqai.ai-decisions
KAFKA_TOPIC_ANALYTICS=resqai.analytics
KAFKA_TOPIC_ROUTES=resqai.routes

# ----- CELERY (Task Queue) -----
CELERY_BROKER_URL=redis://:redis_secure_password_change_me@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secure_password_change_me@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ----- FSSAI API -----
FSSAI_API_KEY=your_fssai_api_key
FSSAI_BASE_URL=https://api.fssai.gov.in/v1

# ----- GOVERNMENT NGO API -----
GOVT_NGO_API_KEY=your_govt_ngo_api_key
GOVT_NGO_BASE_URL=https://ngodarpan.gov.in/api/v1

# ----- IOT SENSORS -----
IOT_MQTT_BROKER=mqtt://iot-broker:1883
IOT_MQTT_TOPIC=resqai/sensors/temperature
IOT_API_KEY=your_iot_api_key

# ----- MONITORING -----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secure_password_change_me

# ----- SENTRY (Error Tracking) -----
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ----- RATE LIMITING -----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----- CORS -----
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID

# ----- LOGGING -----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/resqai.log

# ----- FEATURE FLAGS -----
ENABLE_AI_AGENTS=true
ENABLE_RAG=true
ENABLE_MCP=true
ENABLE_KAFKA=true
ENABLE_IOT=false
ENABLE_VOICE_ASSISTANT=false
